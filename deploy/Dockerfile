FROM python:3.12-slim

# ffmpeg es obligatorio: hace toda la decodificación y la captura de streams.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY fonoscan/ ./fonoscan/
RUN mkdir -p /var/lib/fonoscan/plays /var/lib/fonoscan/evidencia

ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "fonoscan.cli", "--help"]
